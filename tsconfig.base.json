{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // Every `@soribashi/*` package's "exports" map points at its built `dist/`
    // (that is what consumers install), with a `"soribashi-source"` condition
    // listed first that points back at `src/`. Opting into that condition here
    // is what keeps THIS repo type-checking its own packages as TypeScript
    // source: no build step is required before `bun run typecheck`, a change in
    // `packages/theme/src` is seen immediately by `packages/factory`, and
    // go-to-definition lands on real source rather than a `.d.ts`.
    // The published artifact is unaffected — no consumer sets this condition,
    // so every consumer resolves `dist/` and never type-checks our source.
    // Vitest and Vite opt in the same way, via `resolve.conditions`; Bun does
    // via `--conditions=soribashi-source` in the root package.json scripts.
    "customConditions": ["soribashi-source"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Explicit under TypeScript 7: with no "types" array, TS 5.x auto-discovered
    // @types/node by walking up node_modules/@types from wherever tsconfig.json
    // was resolved, so per-package `tsc --noEmit` runs (cwd inside packages/*)
    // picked up the hoisted root @types/node ambient globals (process, Buffer,
    // node:fs, ...) with no config needed. Under TS 7.0.2 that walk-up no
    // longer resolves the ambient globals for a per-package tsconfig.json (even
    // one with its own local node_modules/@types/node, e.g. packages/codegen) —
    // only the root-rooted aggregate `tsc -p tsconfig.json` happened to still
    // work, because tsconfig.json itself lives at the repo root. Declaring
    // "node" here restores the same ambient globals for every package's own
    // `bun run typecheck`, not just the root gate. Safe to scope to just
    // "node": nothing else in this repo relies on ambient/global "types"
    // discovery — @types/react resolves via normal `import` module resolution,
    // and @testing-library/jest-dom's matchers are wired via an explicit
    // `import '@testing-library/jest-dom/vitest'` side effect, not the ambient
    // "types" mechanism, so neither is affected by scoping this list down.
    // If a future dependency needs its own ambient/global types (rather than
    // types resolved through a normal `import`), add its package name to this
    // array. Do not delete the array and fall back on auto-discovery, since
    // that's the exact behavior this comment documents as unreliable under TS 7.
    "types": ["node"],

    // Off for the checking configs (this is the base every `--noEmit` run
    // extends), where emitting declarations buys nothing and only adds TS2742
    // nameability checks on inferred types that are never written out.
    // The publishable packages DO ship declarations: each one's
    // `tsconfig.build.json` turns `declaration` back on alongside `noEmit:
    // false` and is the only config that emits.
    "declaration": false,
    "sourceMap": true,

    "composite": false
  },
  "exclude": ["node_modules", "dist", "build"]
}
