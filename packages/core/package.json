{
  "name": "@soribashi/core",
  "version": "0.3.0",
  "description": "Soribashi: a theme model, a component factory, and the `soribashi` CSS codegen CLI in one package. Framework only — it ships no components.",
  "license": "MIT",
  "author": "Matthew Goodwin",
  "homepage": "https://github.com/m4ttheweric/soribashi#readme",
  "bugs": {
    "url": "https://github.com/m4ttheweric/soribashi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4ttheweric/soribashi.git",
    "directory": "packages/core"
  },
  "keywords": [
    "soribashi",
    "react",
    "design-system",
    "theme",
    "design-tokens",
    "style-props",
    "component-factory",
    "tailwindcss",
    "cli"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "soribashi": "./dist/bin/soribashi.js"
  },
  "exports": {
    ".": {
      "soribashi-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./codegen": {
      "soribashi-source": "./src/codegen/index.ts",
      "types": "./dist/src/codegen/index.d.ts",
      "default": "./dist/src/codegen/index.js"
    },
    "./testing": {
      "soribashi-source": "./src/testing/index.ts",
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    },
    "./testing/contrast": {
      "soribashi-source": "./src/testing/contrast.ts",
      "types": "./dist/src/testing/contrast.d.ts",
      "default": "./dist/src/testing/contrast.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun ../../scripts/fix-dts-extensions.ts dist",
    "prepack": "bun run build",
    "test": "vitest run --config vitest.node.config.ts && vitest run --config vitest.dom.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0",
    "zod": "^4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vitest": "^4",
    "vitest-browser-react": "^2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "vitest-browser-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^25.0.0",
    "react": "^19.2",
    "react-dom": "^19.2",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4",
    "vitest-browser-react": "^2.2.0"
  }
}
