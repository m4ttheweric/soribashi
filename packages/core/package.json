{
  "name": "@soribashi/core",
  "version": "0.1.0",
  "description": "The Soribashi barrel: one import for the factory's builders and the theme's model. Framework only \u2014 it ships no components.",
  "license": "MIT",
  "author": "Matthew Goodwin",
  "homepage": "https://github.com/m4ttheweric/soribashi#readme",
  "bugs": {
    "url": "https://github.com/m4ttheweric/soribashi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4ttheweric/soribashi.git",
    "directory": "packages/core"
  },
  "keywords": [
    "soribashi",
    "react",
    "design-system",
    "theme",
    "component-factory"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "soribashi-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun ../../scripts/fix-dts-extensions.ts dist",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@soribashi/factory": "workspace:*",
    "@soribashi/theme": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "typescript": "^7"
  }
}
