{
  "name": "@soribashi/factory",
  "version": "0.1.0",
  "description": "Soribashi's component factory: defineComponent, defineCompound, polymorphic and generic builders, style props, and the theme-driven styling machinery behind them.",
  "license": "MIT",
  "author": "Matthew Goodwin",
  "homepage": "https://github.com/m4ttheweric/soribashi#readme",
  "bugs": {
    "url": "https://github.com/m4ttheweric/soribashi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4ttheweric/soribashi.git",
    "directory": "packages/factory"
  },
  "keywords": [
    "soribashi",
    "react",
    "design-system",
    "style-props",
    "component-factory"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "soribashi-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun ../../scripts/fix-dts-extensions.ts dist",
    "prepack": "bun run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@soribashi/theme": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^25.0.0",
    "react": "^19.2",
    "react-dom": "^19.2",
    "typescript": "^7",
    "vitest": "^4"
  }
}
