{
  "name": "soribashi",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format . --write",
    "codegen": "bun run packages/codegen/bin/soribashi.ts build",
    "codegen:watch": "bun run packages/codegen/bin/soribashi.ts watch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.0",
    "playwright": "^1.59.1",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^4"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
