{
  "name": "soribashi",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/theme build && bun run --cwd packages/factory build && bun run --cwd packages/core build && bun run --cwd packages/codegen build",
    "pack:check": "bun scripts/verify-pack.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "vitest run --config packages/ui/vitest.visual.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format . --write",
    "codegen": "bun run --cwd packages/ui codegen",
    "codegen:watch": "bun run --cwd packages/ui codegen:watch",
    "codegen:tenants": "bun --conditions=soribashi-source apps/workshop/scripts/codegen-tenants.ts",
    "dev:workshop": "bun run --cwd apps/workshop dev",
    "generate:ui": "bun --conditions=soribashi-source packages/ui/scripts/generate-manifest.ts && bun --conditions=soribashi-source packages/ui/scripts/generate-registry.ts",
    "smoke:registry": "bun --conditions=soribashi-source packages/ui/scripts/registry-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.0",
    "playwright": "^1.59.1",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^4"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
